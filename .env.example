# --- Required ---------------------------------------------------------------
APP_ENV=dev                      # dev | test | prod
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dialogbot

# --- Required in prod (process refuses to start without them) -------------
# SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters

# --- Auth ------------------------------------------------------------------
AUTH_PROVIDER=local              # local = argon2 passwords + server sessions. "external" (OIDC) is reserved and fails closed.
SESSION_TTL_HOURS=336
INVITATION_TTL_HOURS=72
RESET_TTL_MINUTES=60
VERIFICATION_TTL_HOURS=48

# --- Email -----------------------------------------------------------------
EMAIL_ADAPTER=simulated          # simulated | resend. simulated is not allowed in prod.
# RESEND_API_KEY=                # required when EMAIL_ADAPTER=resend
# DB_SCHEMA=dialogbot            # Supabase: dedicated schema kept out of the Data API
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
EMAIL_FROM=Dialogbot <noreply@dialogbot.local>

# --- Dev tooling (simulated mailbox + outbox view at /api/v1/dev/*) --------
ENABLE_DEV_TOOLS=true            # must be false in prod

# --- Worker ----------------------------------------------------------------
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=5

# --- Links in outgoing mail -----------------------------------------------
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# --- Seed (dev/test only) ---------------------------------------------------
# SEED_DEMO_PASSWORD=            # if unset, the seed prints a random password once (never a fixed default)

LOG_LEVEL=INFO

# Handlinger i kundens systemer (docs/environment-variables.md). CREDENTIALS_KEY: python -m scripts.credentials_key
CREDENTIALS_KEY=
CONNECTORS_PROVIDER=live
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Pakker-appen (Privat): 17TRACK-nøgle til pakkesporing. Tom = appen er «Kommer snart».
TRACK17_API_KEY=
# Rejser-appen (Privat): Duffel og/eller Travelpayouts. Uden begge er appen «Kommer snart».
DUFFEL_ACCESS_TOKEN=
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# Partner links in the Privat apps, JSON per category (docs/sales/privat-revenue.md); empty = none shown
PRIVAT_PARTNER_LINKS=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Browser worker: books on external public booking pages after a human yes (docs/ADR-004-browser-worker.md).
# Prod/staging refuse to start with BROWSER_WORKER_ENABLED=true without SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY.
BROWSER_WORKER_ENABLED=false
BROWSER_MAX_STEPS=25
BROWSER_MAX_SECONDS=180
BROWSER_APPROVAL_TTL_SECONDS=600
BROWSER_ALLOWED_ENGINES=onlinebooq
BROWSER_EVIDENCE_BUCKET=browser-evidence

# Lead loop: the fixed closing line of a Privat call (docs/sales/privat-opkald-leads.md). Off until a lawyer has confirmed it.
LEAD_PITCH_ENABLED=false
LEAD_PITCH_COOLDOWN_DAYS=90

# --- Cold e-mail outreach for Dialogbot's own sales (docs/sales/cold-outreach.md) ---------------------------------
# off | dry_run | live. dry_run checks, researches, writes and audits – and never sends. live refuses to start
# without OUTREACH_SENDER_INBOXES, OUTREACH_POSTAL_ADDRESS, the provider's key and AI_PROVIDER=anthropic.
OUTREACH_MODE=off
# ANTHROPIC_API_KEY=             # shared with the rest of the app; set AI_PROVIDER=anthropic
CLAUDE_RESEARCH_MODEL=claude-sonnet-4-6
CLAUDE_WRITER_MODEL=claude-sonnet-4-6
CLAUDE_AUDITOR_MODEL=claude-haiku-4-5
OUTREACH_AI_MAX_RETRIES=4        # SDK retries with backoff on 429/5xx/connection errors
OUTREACH_WEB_SEARCH=true         # research agent may use Anthropic's web search tool
OUTREACH_MIN_CONFIDENCE=0.6
# Sending provider: resend | smtp (instantly | smartlead are reserved and refuse to start in live mode)
OUTREACH_PROVIDER=resend
OUTREACH_RESEND_API_KEY=
OUTREACH_SMTP_HOST=
OUTREACH_SMTP_PORT=587
OUTREACH_SMTP_USERNAME=
OUTREACH_SMTP_PASSWORD=
# Sender identity
OUTREACH_SENDER_NAME=Dialogbot
OUTREACH_SENDER_INBOXES=         # comma-separated sending addresses, e.g. rene@mail.dialogbot.app
OUTREACH_LEGAL_NAME=Dialogbot, CVR 25632710
OUTREACH_POSTAL_ADDRESS=         # full postal address (street, postal code, city, country); required in live mode
OUTREACH_PRIVACY_URL=https://dialogbot.app/privatliv
OUTREACH_DAILY_LIMIT_PER_INBOX=30
OUTREACH_DAILY_LIMIT_PER_DOMAIN=150
# Markets and copy
OUTREACH_SIGNED_OFF_MARKETS=     # ES,PL stay on hold until a lawyer has signed them off
OUTREACH_CALL_QUEUE_COUNTRIES=DK
OUTREACH_DEMO_CALLBACK_COUNTRIES=DK   # countries the callback demo can ring; live sending elsewhere waits
OUTREACH_CALLBACK_NUMBER_US=     # local number the demo rings from; unset = the copy may not mention one
OUTREACH_CALLBACK_NUMBER_UK=
OUTREACH_PRICE_US=$349/mo
OUTREACH_PRICE_UK=£275/mo
# Provider events: Resend signs with RESEND_WEBHOOK_SECRET (above); other senders post with X-Outreach-Secret
OUTREACH_WEBHOOK_SECRET=
