# --- Required ---------------------------------------------------------------
APP_ENV=dev                      # dev | test | prod
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dialogbot

# --- Required in prod (process refuses to start without them) -------------
# SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters

# --- Auth ------------------------------------------------------------------
AUTH_PROVIDER=local              # local = argon2 passwords + server sessions. "external" (OIDC) is reserved and fails closed.
SESSION_TTL_HOURS=336
INVITATION_TTL_HOURS=72
RESET_TTL_MINUTES=60
VERIFICATION_TTL_HOURS=48

# --- Email -----------------------------------------------------------------
EMAIL_ADAPTER=simulated          # simulated | resend. simulated is not allowed in prod.
# RESEND_API_KEY=                # required when EMAIL_ADAPTER=resend
# DB_SCHEMA=dialogbot            # Supabase: dedicated schema kept out of the Data API
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
EMAIL_FROM=Dialogbot <noreply@dialogbot.local>

# --- Dev tooling (simulated mailbox + outbox view at /api/v1/dev/*) --------
ENABLE_DEV_TOOLS=true            # must be false in prod

# --- Worker ----------------------------------------------------------------
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=5

# --- Links in outgoing mail -----------------------------------------------
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# --- Seed (dev/test only) ---------------------------------------------------
# SEED_DEMO_PASSWORD=            # if unset, the seed prints a random password once (never a fixed default)

LOG_LEVEL=INFO
